{
  "name": "@ionify/ionify",
  "version": "0.1.10",
  "type": "module",
  "description": "Ionify — Instant, Intelligent, Unified Build Engine",
  "bin": {
    "ionify": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "scripts": {
    "dev": "pnpm build && node dist/cli/index.js dev",
    "build": "node -e \"const fs=require('fs');const required=['dist/cli/index.js','dist/cli/index.cjs','dist/index.js','dist/index.cjs','dist/index.d.ts','dist/ionify_core.node'];const missing=required.filter((f)=>!fs.existsSync(f));if(missing.length){console.error('Missing publish artifacts:\\n'+missing.join('\\n'));process.exit(1)}console.log('✅ Publish artifacts verified.');\"",
    "build:link": "pnpm build && pnpm link --global",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "bench:minifier": "node scripts/bench-minifier.mjs",
    "bench:cold-start": "node scripts/bench-cold-start.mjs",
    "clean": "rm -rf dist .ionify target/debug target/release"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "rollup",
    "bundler",
    "rust",
    "build-engine",
    "ionify"
  ],
  "author": "Khaled Salem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionifyjs/ionify.git"
  },
  "bugs": {
    "url": "https://github.com/ionifyjs/ionify/issues"
  },
  "homepage": "https://ionify.cloud",
  "dependencies": {
    "@swc/core": "^1.7.14",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "es-module-lexer": "^1.5.2",
    "esbuild": "^0.25.11",
    "postcss": "^8.4.47",
    "postcss-load-config": "^4.0.2",
    "postcss-modules": "^4.3.1",
    "react-refresh": "^0.14.2",
    "selfsigned": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@types/node": "^22.0.0",
    "esbuild-plugin-alias": "^0.2.1",
    "eslint": "^9.14.0",
    "lodash": "4.17.21",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
